    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-config</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime-cluster-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime-management</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime-osgi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime-metrics</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime-mongodb</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-idempotency</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime-jtajca</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime-kv</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime-pubsub</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime-springboot</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime-springboot-test</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-runtime-test</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Core -->
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-schema</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-binarymanager-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-cache</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-event</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-io</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-management-jtajca</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-mongodb</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-query</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-storage-mem</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-storage-mongodb</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-core-test</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- OpenArch Platform -->
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-usermanager</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-login-filestore</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-login</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-opensearch</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-platform-test</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-rest-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-rest-document</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-usermanager-test</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-vocabularies</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- OpenArch Server -->
    <dependency>
      <groupId>com.hyland.openarch</groupId>
      <artifactId>openarch-server-common</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>merge-results</id>
            <phase>verify</phase>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${coverage.reporting.outputDirectory}</directory>
                  <includes>
                    <include>**/**.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/aggregate.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>coverage-report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
