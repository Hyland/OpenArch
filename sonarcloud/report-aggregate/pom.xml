<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.hyland.hxpr</groupId>
    <artifactId>sonarcloud-modules</artifactId>
    <version>0.0.20</version>
  </parent>

  <artifactId>report-aggregate</artifactId>
  <packaging>pom</packaging>
  <name>Test Coverage Aggregrate Report</name>
  <description>Aggregates the coverate report from our individual hxpr-community modules</description>

  <dependencies>
    <!-- Modules -->

    <!-- Runtime -->
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-config</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-management</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-osgi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-metrics</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-mongodb</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-jtajca</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-kv</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-pubsub</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-springboot</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-springboot-test</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-test</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Core -->
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-core-schema</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-core-api</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>merge-results</id>
            <phase>verify</phase>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${coverage.reporting.outputDirectory}</directory>
                  <includes>
                    <include>**/**.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/aggregate.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>coverage-report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
