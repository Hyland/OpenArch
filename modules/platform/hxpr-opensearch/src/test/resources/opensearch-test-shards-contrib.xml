<?xml version="1.0"?>
<component name="org.nuxeo.opensearch.test.shards.contrib">

  <!-- Three indexes sharing the same settings file but using different shard counts, which is the
       case the numberOfShards attribute exists for. -->
  <extension point="openSearchIndex" target="org.nuxeo.opensearch.OpenSearchService">
    <openSearchIndex name="nxushardsdoc" repository="test" type="doc" numberOfShards="6">
      <settings file="opensearch-doc-settings.json" />
      <mapping file="opensearch-doc-mapping.json" />
    </openSearchIndex>

    <openSearchIndex name="nxushardsvoc" repository="test_vocabularies" type="doc" numberOfShards="1">
      <settings file="opensearch-doc-settings.json" />
      <mapping file="opensearch-doc-mapping.json" />
    </openSearchIndex>

    <openSearchIndex name="nxushardscfg" repository="test_configuration" type="doc" numberOfShards="1">
      <settings file="opensearch-doc-settings.json" />
      <mapping file="opensearch-doc-mapping.json" />
    </openSearchIndex>

    <openSearchIndex name="nxushardslegacy" repository="test_legacy" type="doc" numberOfShards="${opensearch.test.indexNumberOfShards:=2}">
      <settings file="opensearch-doc-settings.json" />
      <mapping file="opensearch-doc-mapping.json" />
    </openSearchIndex>
  </extension>

</component>
