<?xml version="1.0"?>
<xs:schema targetNamespace="http://www.hyland.com/openarch/ecm/schemas/mydublincore/"
		   xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:nxs="http://www.hyland.com/openarch/ecm/schemas/mydublincore/"
           xmlns:ref="http://www.hyland.com/openarch/ecm/schemas/core/external-references/">

  <xs:simpleType name="stringList">
    <xs:list>
      <xs:simpleType>
        <xs:restriction base="xs:string" />
      </xs:simpleType>
    </xs:list>
  </xs:simpleType>

  <xs:element name="subjects" type="nxs:stringList" />
  <xs:element name="rights" type="xs:string" />
  <xs:element name="source" type="xs:string" />
  <xs:element name="coverage" type="xs:string" />
  <xs:element name="issued" type="xs:date" />
  <xs:element name="valid" type="xs:date" />
  <xs:element name="expired" type="xs:date" />
  <xs:element name="format" type="xs:string" />
  <xs:element name="language" type="xs:string" />
  <xs:element name="nature" type="xs:string" />
  <xs:element name="publisher" type="xs:string" />
  <xs:element name="decimal" type="xs:decimal" />

</xs:schema>
