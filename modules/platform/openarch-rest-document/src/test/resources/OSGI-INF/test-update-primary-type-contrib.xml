<component name="com.hyland.openarch.rest.facetsandtypes.test">

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="schema">
    <schema name="mycustomschema" prefix="mcs" src="schema/customschema.xsd" />
    <schema name="mycustomschema2" prefix="mcs2" src="schema/customschema2.xsd" />
  </extension>

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="doctype">
    <doctype name="File2" extends="SysContent">
      <schema name="mycustomschema" />
      <mixin name="File2Facet" />
    </doctype>
    <doctype name="GovernableFile" extends="SysContent">
      <mixin name="SysFilish" />
      <mixin name="SysGovernable" />
    </doctype>
    <mixin name="File2Facet">
      <schema name="mycustomschema2" />
    </mixin>
  </extension>

</component>
