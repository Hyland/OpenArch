<?xml version="1.0"?>
<component name="com.hyland.openarch.test.types.external-user-relations-security-policy">

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="schema">
    <schema name="owned" src="schema/owned.xsd" prefix="own" />
  </extension>

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="doctype">
    <mixin name="Owned">
      <schema name="owned" />
    </mixin>
    <doctype name="OwnedFile" extends="SysFile">
      <mixin name="Owned" />
    </doctype>
  </extension>

</component>
