<?xml version="1.0"?>
<component name="com.hyland.openarch.test.write.types">

  <require>com.hyland.openarch.ecm.core.CoreExtensions</require>

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="schema">
    <schema name="any" prefix="any" src="schema/any.xsd"/>
  </extension>

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="doctype">
    <doctype name="MyFile" extends="SysFile">
      <schema name="any" />
      <mixin name="SysVersionable" />
    </doctype>
    <doctype name="MyGovernableFile" extends="SysFile">
      <schema name="any" />
      <mixin name="SysGovernable" />
    </doctype>
  </extension>

</component>
