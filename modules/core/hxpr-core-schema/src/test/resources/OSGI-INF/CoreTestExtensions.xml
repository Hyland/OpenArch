<component name="org.nuxeo.ecm.core.test">

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="schema-lib" src="schema/schema-lib.xsd" /> <!-- includes first -->
    <schema name="schema1" src="schema/schema.xsd" />
    <schema name="schema2" src="schema/schema2.xsd" />
    <schema name="schema3" src="schema/schema3.xsd" />
    <schema name="common" src="schema/common.xsd" />
    <schema name="facetSchema1" src="schema/facetSchema1.xsd" />
  </extension>


  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <mixin name="viewable" />
    <doctype name="myDoc" extends="SysContent">
      <schema name="schema2" />
      <mixin name="viewable" />
      <mixin name="writable" />
    </doctype>
    <doctype name="myDoc2" extends="SysContent">
      <schema name="schema1" />
      <mixin name="myfacet" />
    </doctype>
    <mixin name="myfacet">
      <schema name="schema2" />
    </mixin>
    <doctype name="myDoc3" extends="myDoc2">
    </doctype>
    <doctype name="myDoc4" extends="SysContent">
      <schema name="schema3" />
    </doctype>
    <doctype name="myFolder" extends="SysContent">
      <subtypes>
        <type>myDoc</type>
        <type>myDoc2</type>
        <type>myDoc3</type>
      </subtypes>
    </doctype>
    <doctype name="myFolder2" extends="myFolder">
      <subtypes>
        <type>myDoc4</type>
      </subtypes>
    </doctype>
    <doctype name="mySpecialFolder" extends="SysContent">
      <subtypes>
        <type>myDoc</type>
        <type>myDoc2</type>
        <type>myDoc3</type>
        <type>myDoc4</type>
        <type>myFolder</type>
      </subtypes>
    </doctype>
    <mixin name="fakeFacet1">
      <schema name="facetSchema1" />
    </mixin>
  </extension>


</component>
