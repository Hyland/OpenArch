<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.hyland.hxpr</groupId>
    <artifactId>hxpr-community-core-parent</artifactId>
    <version>0.0.26-SNAPSHOT</version>
  </parent>
  <artifactId>hxpr-core-schema</artifactId>
  <name>HxPR Core Schema</name>

  <properties>
    <manifest.file>src/main/resources/META-INF/MANIFEST.MF</manifest.file>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.sun.xsom</groupId>
      <artifactId>xsom</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-config</artifactId>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <archive>
                <manifestFile>src/test/resources/META-INF/MANIFEST.MF</manifestFile>
              </archive>
            </configuration>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
