<?xml version="1.0"?>
<component name="org.nuxeo.ecm.core.transient.store.config">

  <extension target="com.hyland.openarch.ecm.core.transientstore.TransientStorageComponent"
             point="store">

    <store name="default" class="com.hyland.openarch.ecm.core.transientstore.keyvalueblob.KeyValueBlobTransientStore">
      <targetMaxSizeMB>-1</targetMaxSizeMB>
      <absoluteMaxSizeMB>-1</absoluteMaxSizeMB>
      <firstLevelTTL>${nuxeo.transientstore.ttl:=4320}</firstLevelTTL>
      <secondLevelTTL>${nuxeo.transientstore.ttl2:=10}</secondLevelTTL>
    </store>

    <store name="authorizationRequestStore">
      <firstLevelTTL>10</firstLevelTTL>
      <secondLevelTTL>0</secondLevelTTL>
    </store>

  </extension>

  <extension target="com.hyland.hxpr.async.tasks.AsyncTasksService" point="asyncTasks">
    <asyncTask name="transientStorageGC" class="com.hyland.openarch.ecm.core.transientstore.TransientStorageGCTaskProcessor"/>
  </extension>


</component>
