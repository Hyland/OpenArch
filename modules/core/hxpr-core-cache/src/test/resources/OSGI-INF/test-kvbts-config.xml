<?xml version="1.0"?>
<component name="org.nuxeo.ecm.core.cache.ts.keyvalueblob.test">

  <!-- a default key/value store is already provided by another contrib -->

  <extension target="org.nuxeo.ecm.core.blob.BlobService" point="configuration">
    <blobprovider name="default">
      <class>org.nuxeo.ecm.core.blob.LocalBlobProvider</class>
    </blobprovider>
    <blobprovider name="mytransient">
      <class>org.nuxeo.ecm.core.blob.LocalBlobProvider</class>
      <property name="path">mytransientbinaries</property>
    </blobprovider>
    <!-- InMemoryBlobProvider: its GC extends AbstractBlobGarbageCollector,
         enabling coverage of the instanceof fast-exit branch in doGC(). -->
    <blobprovider name="inmemtransient">
      <class>org.nuxeo.ecm.core.blob.InMemoryBlobProvider</class>
      <property name="transient">true</property>
    </blobprovider>
  </extension>

  <extension target="org.nuxeo.ecm.core.transientstore.TransientStorageComponent" point="store">
    <store name="default" class="org.nuxeo.ecm.core.transientstore.keyvalueblob.KeyValueBlobTransientStore">
      <targetMaxSizeMB>1</targetMaxSizeMB>
      <absoluteMaxSizeMB>1</absoluteMaxSizeMB>
      <property name="defaultBlobProvider">mytransient</property>
    </store>
    <!-- Store backed by InMemoryBlobProvider for doGC() fast-exit coverage. -->
    <store name="inmemstore" class="org.nuxeo.ecm.core.transientstore.keyvalueblob.KeyValueBlobTransientStore">
      <property name="blobProvider">inmemtransient</property>
    </store>
  </extension>

</component>
