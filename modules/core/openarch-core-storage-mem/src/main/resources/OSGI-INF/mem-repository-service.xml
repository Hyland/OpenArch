<?xml version="1.0"?>
<component name="com.hyland.openarch.ecm.core.storage.mem.MemRepositoryService">

  <require>com.hyland.openarch.ecm.core.storage.dbs.DBSRepositoryService</require>

  <documentation>
    Manages Memory repositories.
  </documentation>

  <implementation class="com.hyland.openarch.ecm.core.storage.mem.MemRepositoryService" />

  <service>
    <provide interface="com.hyland.openarch.ecm.core.storage.mem.MemRepositoryService" />
  </service>

  <extension-point name="repository">
    <documentation>
      Extension points to register Memory repositories. Example:
      <code>
        <repository name="default" label="Mem Repository" isDefault="true">
          <fulltext disabled="false" />
        </repository>
      </code>
    </documentation>
    <object class="com.hyland.openarch.ecm.core.storage.mem.MemRepositoryDescriptor" />
    <registry class="com.hyland.openarch.ecm.core.storage.mem.MemRepositoryService$Registry" />
  </extension-point>

</component>
