<?xml version="1.0"?>
<component name="org.nuxeo.ecm.blob.cloud.doctype.test">

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="cloud-test" src="schemas/file.xsd" prefix="cloud-test" />
    <schema name="cloud-other" src="schemas/file.xsd" prefix="cloud-other" />
  </extension>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <doctype name="CloudFile" extends="SysContent">
      <schema name="cloud-test" />
      <schema name="cloud-other" />
    </doctype>
  </extension>

  <extension target="org.nuxeo.ecm.core.blob.DocumentBlobService" point="configuration">
    <blobdispatcher>
      <class>org.nuxeo.ecm.core.blob.DefaultBlobDispatcher</class>
      <property name="blob_xpath=cloud-test_blob">test</property>
      <property name="blob_xpath=cloud-other_blob">other</property>
      <property name="default">test</property>
    </blobdispatcher>
  </extension>

</component>
