<?xml version="1.0"?>
<component name="org.nuxeo.ecm.blob.cloud.record.doctype.test">

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="doctype">
    <doctype name="MyFile" extends="SysFile">
      <mixin name="SysVersionable"/>
    </doctype>
  </extension>

  <extension target="com.hyland.openarch.ecm.core.blob.DocumentBlobService" point="configuration">
    <blobdispatcher>
      <class>com.hyland.openarch.ecm.core.blob.DefaultBlobDispatcher</class>
      <property name="default">test</property>
    </blobdispatcher>
  </extension>

</component>
