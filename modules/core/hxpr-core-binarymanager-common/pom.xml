<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.hyland.hxpr</groupId>
    <artifactId>hxpr-community-core-parent</artifactId>
    <version>0.0.105</version>
  </parent>

  <artifactId>hxpr-core-binarymanager-common</artifactId>
  <name>HxPR Core BinaryManager Common</name>

  <properties>
    <manifest.file>src/main/resources/META-INF/MANIFEST.MF</manifest.file>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-core-io</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-core</artifactId>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
    </dependency>

    <!-- Test dependencies, for the shared cloud blob provider test bases -->
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-runtime-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-core-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>hxpr-core-api</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <archive>
                <manifestFile>src/test/resources/META-INF/MANIFEST.MF</manifestFile>
              </archive>
            </configuration>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
