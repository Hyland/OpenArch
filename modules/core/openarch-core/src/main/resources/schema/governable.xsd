<?xml version="1.0"?>
<xs:schema targetNamespace="http://www.hyland.com/openarch/ecm/schemas/governable/"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:nxs="http://www.hyland.com/openarch/ecm/schemas/governable/"
           xmlns:m="http://www.hyland.com/openarch/ecm/schemas/core/managed/">

  <xs:include schemaLocation="core-types.xsd" />

  <xs:element name="isRecord" type="xs:boolean"
              m:noAutoCheckout="true" m:falseAsNull="STORE,INDEX"
              m:writePermission="ManageRetention"
              m:versionWritePermission="STANDARD" />
  <xs:element name="hasLegalHold" type="xs:boolean"
              m:noAutoCheckout="true" m:falseAsNull="STORE,INDEX"
              m:writePermission="ManageRetention"
              m:versionWritePermission="STANDARD" />
  <xs:element name="retainUntil" type="xs:date"
              m:noAutoCheckout="true" m:writePermission="ManageRetention"
              m:versionWritePermission="STANDARD" />
</xs:schema>
