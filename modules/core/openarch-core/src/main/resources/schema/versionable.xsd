<?xml version="1.0"?>
<xs:schema targetNamespace="http://www.hyland.com/openarch/ecm/schemas/versionable/" xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:nxs="http://www.hyland.com/openarch/ecm/schemas/versionable/"
           xmlns:ref="http://www.hyland.com/openarch/ecm/schemas/core/external-references/"
           xmlns:m="http://www.hyland.com/openarch/ecm/schemas/core/managed/">

  <xs:element name="created" type="xs:date"
              m:systemOwned="true" />
  <xs:element name="creator" type="xs:string"
              m:systemOwned="true" />
  <xs:element name="description" type="xs:string"
              m:versionWritePermission="WriteVersion" />
  <xs:element name="isCheckedIn" type="xs:boolean"
              m:systemOwned="true" m:falseAsNull="STORE,INDEX" />
  <xs:element name="isTemp" type="xs:boolean"
              m:systemOwned="true" />
  <xs:element name="isVersion" type="xs:boolean"
              m:systemOwned="true" m:falseAsNull="STORE,INDEX" />
  <xs:element name="minorVersion" type="xs:long"
              m:systemOwned="true" />
  <xs:element name="title" type="xs:string"
              m:versionWritePermission="WriteVersion" />
  <xs:element name="version" type="xs:long"
              m:systemOwned="true" />

</xs:schema>
