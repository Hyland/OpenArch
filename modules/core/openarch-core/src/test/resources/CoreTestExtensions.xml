<component name="com.hyland.openarch.ecm.core.test">

	<extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="schema">
		<schema name="schema1" src="schema/schema.xsd"/>
		<schema name="lib" src="schema/schema-lib.xsd"/>
		<schema name="schema2" src="schema/schema2.xsd"/>
	</extension>


	<extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="doctype">
		<doctype name="myDoc" extends="document">
			<schema name="schema2"/>
			<mixin name="viewable"/>
			<mixin name="writable"/>
		</doctype>
	</extension>


</component>
