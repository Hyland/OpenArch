<?xml version="1.0"?>
<component name="org.nuxeo.ecm.core.CoreExtensions.security">

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService"
    point="schema">
    <schema name="secupolicy" src="schema/secupolicy.xsd" prefix="sp" />
    <schema name="mapping" src="schema/mapping.xsd" prefix="mp" />

  </extension>

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService"
    point="doctype">
    <doctype name="SysFolder" extends="SysContent">
      <schema name="secupolicy" />
      <mixin name="SysFolderish" />
    </doctype>

     <doctype name="MappingDoc" extends="SysContent">
      <schema name="mapping" />
     </doctype>

  </extension>

</component>
