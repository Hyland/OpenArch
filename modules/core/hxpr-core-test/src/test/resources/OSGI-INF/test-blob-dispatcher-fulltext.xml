<?xml version="1.0"?>
<component name="org.nuxeo.ecm.core.blob.test-blob-dispatcher-fulltext">
  <extension target="org.nuxeo.ecm.core.blob.BlobService" point="configuration">
    <blobprovider name="fulltext">
      <class>org.nuxeo.ecm.core.blob.LocalBlobProvider</class>
      <property name="path">fulltext</property>
    </blobprovider>
  </extension>
  <extension target="org.nuxeo.ecm.core.blob.DocumentBlobService" point="configuration">
    <blobdispatcher>
      <class>org.nuxeo.ecm.core.blob.DefaultBlobDispatcher</class>
      <property name="blob_xpath=sys_fulltextBinary">fulltext</property>
      <property name="default">test</property>
    </blobdispatcher>
  </extension>
</component>
