<?xml version="1.0"?>
<component name="org.nuxeo.ecm.core.tests.resolver">

  <extension target="com.hyland.openarch.ecm.core.schema.ObjectResolverService" point="resolvers">
    <resolver type="colorResolver" class="com.hyland.openarch.ecm.core.schema.types.resolver.TestingColorResolver" />
  </extension>

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="schema">
    <schema name="resolverSample" src="schemas/resolverSample.xsd" prefix="res" />
  </extension>

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="doctype">
    <doctype name="TestResolver" extends="SysContent">
      <schema name="resolverSample" />
    </doctype>
  </extension>

  <extension target="com.hyland.openarch.ecm.core.api.DocumentValidationService" point="activations">
    <validation context="createDocument" activated="false" />
    <validation context="saveDocument" activated="false" />
  </extension>

</component>
