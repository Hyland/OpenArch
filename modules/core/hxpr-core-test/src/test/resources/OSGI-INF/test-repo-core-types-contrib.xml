<?xml version="1.0"?>
<component name="org.nuxeo.ecm.core.storage.sql.tests.repo.core-types">

  <require>org.nuxeo.ecm.core.CoreExtensions</require>

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="schema">
    <schema name="mydublincore" prefix="mydc" src="schemas/mydublincore.xsd"/>
    <schema name="note" src="schemas/note.xsd"/>
    <schema name="mylib" src="schemas/mylib.xsd" />
    <schema name="myschema" src="schemas/myschema.xsd" prefix="my" />
    <schema name="book" src="schemas/book.xsd" prefix="book" />
    <schema name="testList" src="schemas/mytestlist.xsd" prefix="" />
    <schema name="complexschema" src="schemas/complexschema.xsd" prefix="cmpf" />
    <schema name="test-properties" src="schemas/test-properties.xsd"
      prefix="tp" />
    <schema name="age" src="schemas/age.xsd" prefix="age" isVersionWritable="true" />
    <schema name="info" src="schemas/info.xsd" prefix="info" />
    <schema name="complex" src="schemas/complex.xsd" prefix="cpx" />
    <schema name="complexList" src="schemas/complexlist.xsd" prefix="cpxl" />
  </extension>

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="doctype">

    <!-- add mydublincore to standard doctypes -->
    <doctype name="SysFolder" extends="SysContent">
      <schema name="mydublincore"/>
      <mixin name="SysFolderish"/>
      <subtypes>
        <type>SysFolder</type>
        <type>SysOrderedFolder</type>
        <type>SysFile</type>
      </subtypes>
    </doctype>
    <doctype name="SysFile" extends="SysContent">
      <schema name="mydublincore"/>
      <schema name="sysfiles"/>
      <mixin name="SysFilish"/>
    </doctype>

    <doctype name="GovernableFile" extends="SysFile">
      <mixin name="SysGovernable"/>
    </doctype>

    <doctype name="VersionableAndGovernableFile" extends="SysFile">
      <mixin name="SysGovernable"/>
      <mixin name="SysVersionable"/>
    </doctype>

    <mixin name="BrowseViaSearch" />
    <doctype name="MyFile" extends="SysFile">
      <mixin name="SysVersionable"/>
    </doctype>
    <doctype name="Note" extends="SysContent">
      <schema name="note"/>
      <schema name="sysfiles"/>
      <schema name="mydublincore"/>
      <mixin name="SysVersionable"/>
    </doctype>
    <doctype name="FolderWithSearch" extends="SysFolder">
      <mixin name="SysFolderish" />
      <mixin name="BrowseViaSearch" />
    </doctype>
    <doctype name="MyDocType" extends="SysContent">
      <schema name="myschema" />
      <schema name="mydublincore"/>
      <schema name="testList" />
      <schema name="book" />
      <mixin name="SysVersionable"/>
    </doctype>
    <doctype name="MyDocType2" extends="SysContent">
      <schema name="complex" />
      <schema name="complexList" />
    </doctype>
    <doctype name="Book" extends="SysFolder">
      <schema name="book" />
      <mixin name="SysVersionable"/>
    </doctype>
    <doctype name="ComplexDoc" extends="SysContent">
      <schema name="mydublincore"/>
      <schema name="complex" />
      <schema name="complexschema" />
      <mixin name="SysVersionable"/>
    </doctype>
    <doctype name="TestDocument" extends="SysContent">
      <schema name="test-properties" />
    </doctype>
    <doctype name="TestDocument2" extends="SysContent">
      <schema name="mydublincore"/>
      <schema name="test-properties" />
    </doctype>
    <!-- facet tests -->
    <mixin name="Fooable" /> <!-- no content -->
    <mixin name="Aged">
      <schema name="age" />
    </mixin>
    <mixin name="WithFile">
      <schema name="sysfile" />
    </mixin>
    <mixin name="WithFile2">
      <schema name="sysfile" />
    </mixin>
    <mixin name="WithFiles">
      <schema name="sysfiles" />
    </mixin>
    <doctype name="DocWithAge" extends="SysContent">
      <schema name="mydublincore"/>
      <mixin name="Aged" />
    </doctype>
    <doctype name="SpecialFolder" extends="SysFolder">
      <mixin name="SysVersionedWithParent"/>
      <subtypes>
        <type>SysFolder</type>
      </subtypes>
    </doctype>
  </extension>

</component>
