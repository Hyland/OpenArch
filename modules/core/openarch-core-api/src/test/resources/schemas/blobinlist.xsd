<?xml version="1.0"?>

<xs:schema targetNamespace="http://www.hyland.com/openarch/ecm/filemanager/core/listener/test/blobinlist"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.hyland.com/openarch/ecm/filemanager/core/listener/test/blobinlist">

  <xs:complexType name="blob">
    <xs:sequence>
      <xs:element name="encoding" type="xs:string"/>
      <xs:element name="mimeType" type="xs:string"/>
      <xs:element name="key" type="xs:base64Binary"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="blobs" type="nxs:blobs"/>

  <xs:complexType name="blobs">
    <xs:sequence>
      <xs:element name="item" type="nxs:blobitem" minOccurs="0"
        maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="blobitem">
    <xs:sequence>
      <xs:element name="blob" type="nxs:blob"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
