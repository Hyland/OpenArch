<?xml version="1.0"?>

<xs:schema targetNamespace="http://www.hyland.com/openarch/ecm/filemanager/core/listener/test/simpleblob"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.hyland.com/openarch/ecm/filemanager/core/listener/test/simpleblob">

  <xs:complexType name="blob">
    <xs:sequence>
      <xs:element name="encoding" type="xs:string"/>
      <xs:element name="mimeType" type="xs:string"/>
      <xs:element name="key" type="xs:base64Binary"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="blobname" type="xs:string" />
  <xs:element name="blob" type="nxs:blob" />

</xs:schema>
