<?xml version="1.0"?>

<xs:schema targetNamespace="http://www.nuxeo.org/ecm/schemas/files/"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/schemas/files/">

  <xs:include schemaLocation="core-types.xsd" />

  <xs:element name="blobs" type="nxs:blobs" />

  <xs:complexType name="blobs">
    <xs:sequence>
      <xs:element name="item" type="nxs:blobitem" minOccurs="0"
        maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="blobitem">
    <xs:sequence>
      <xs:element name="blob" type="nxs:blob" />
    </xs:sequence>
  </xs:complexType>

</xs:schema>
