          "type": "testquery-schema#attachments"
        },
        "my2_boolean": {
          "type": "boolean"
        },
        "my2_complex": {
          "type": "testquery-schema#complex"
        },
        "my2_content": {
          "type": "blob"
        },
        "my2_date": {
          "type": "date"
        },
        "my2_decimal": {
          "type": "decimal"
        },
        "my2_double": {
          "type": "double"
        },
        "my2_integer": {
          "type": "long"
        },
        "my2_long": {
          "type": "long"
        },
        "my2_name": {
          "type": "testquery-schema#libName"
        },
        "my2_participants": {
          "type": "testquery-schema#theList"
        },
        "my2_string": {
          "type": "string"
        },
        "my2_strings": {
          "type": "testquery-schema#list"
        },
