    "testschema3": {
      "fields": {
        "testschema3_animal": {
          "type": "testschema3#animal"
        },
        "testschema3_whatever": {
          "type": "any"
        }
      },
      "prefix": "testschema3"
    },
    "age": {
      "fields": {
        "age_age": {
          "type": "string"
