        "age_nicknames": {
          "type": "age#stringArray"
        },
        "age_title": {
          "type": "string"
        }
      },
      "prefix": "age"
    },
    "tag": {
      "fields": {
        "tag_label": {
          "type": "string"
        }
      },
      "prefix": "tag"
    },
    "info": {
      "fields": {
        "info_info": {
          "type": "string"
        }
      },
      "prefix": "info"
    }
  },
  "types": {
    "testquery-schema#MyString": {
      "constraints": {
        "nullable": true,
        "pattern": "[a-z]"
      },
      "extends": "string"
    },
    "testquery-schema#attachments": {
      "list": {
        "type": "blob"
      }
    },
    "testquery-schema#complex": {
      "fields": {
        "string": {
          "type": "string"
        },
        "testDefault": {
          "extends": "string",
          "default": "the default value"
        }
      }
    },
    "testquery-schema#libName": {
      "fields": {
        "FirstName": {
          "type": "testquery-schema#MyString"
        },
        "LastName": {
          "type": "string"
        }
      }
    },
    "testquery-schema#list": {
      "list": {
        "type": "string"
      }
    },
    "testquery-schema#theList": {
      "list": {
        "type": "string"
      }
    },
    "testschema#duo": {
      "fields": {
        "first": {
          "type": "testschema#person"
        },
        "second": {
          "type": "testschema#person"
        }
      }
    },
    "testschema#person": {
      "fields": {
        "firstname": {
          "type": "string"
        },
        "lastname": {
          "type": "string"
        }
      }
    },
    "testschema#personList": {
      "list": {
        "type": "testschema#person"
      }
    },
    "testschema#stringArray": {
      "list": {
        "type": "string"
      }
    },
    "testschema3#animal": {
      "fields": {
        "name": {
          "type": "string"
        },
        "race": {
          "type": "string"
        }
      }
    }
  }
}
