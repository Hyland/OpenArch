          "type": "testschema#personList"
        },
        "tst_owner": {
          "type": "testschema#person"
        },
        "tst_rate": {
          "type": "double"
        },
        "tst_subjects": {
          "type": "testschema#stringArray"
        },
        "tst_tags": {
          "type": "testschema#stringArray"
        },
        "tst_title": {
          "type": "string"
        }
      },
      "prefix": "tst"
