<?xml version="1.0"?>
<component name="com.hyland.openarch.ecm.core.blob.test-blob-dispatcher-record">
  <extension target="com.hyland.openarch.ecm.core.blob.BlobService" point="configuration">
    <blobprovider name="records1">
      <class>com.hyland.openarch.ecm.core.blob.LocalBlobProvider</class>
      <property name="record">true</property>
      <property name="path">records1</property>
    </blobprovider>
  </extension>
  <extension target="com.hyland.openarch.ecm.core.blob.DocumentBlobService" point="configuration">
    <blobdispatcher>
      <class>com.hyland.openarch.ecm.core.blob.DefaultBlobDispatcher</class>
      <property name="records">records1</property>
      <property name="default">test</property>
    </blobdispatcher>
  </extension>
  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="model">
    <model src="model/test-blob-dispatcher-record-types.json" />
  </extension>
</component>
