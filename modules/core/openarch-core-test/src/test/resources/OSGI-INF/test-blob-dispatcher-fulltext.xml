<?xml version="1.0"?>
<component name="com.hyland.openarch.ecm.core.blob.test-blob-dispatcher-fulltext">
  <extension target="com.hyland.openarch.ecm.core.blob.BlobService" point="configuration">
    <blobprovider name="fulltext">
      <class>com.hyland.openarch.ecm.core.blob.LocalBlobProvider</class>
      <property name="path">fulltext</property>
    </blobprovider>
  </extension>
  <extension target="com.hyland.openarch.ecm.core.blob.DocumentBlobService" point="configuration">
    <blobdispatcher>
      <class>com.hyland.openarch.ecm.core.blob.DefaultBlobDispatcher</class>
      <property name="blob_xpath=sys_fulltextBinary">fulltext</property>
      <property name="default">test</property>
    </blobdispatcher>
  </extension>
</component>
