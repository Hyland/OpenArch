<?xml version="1.0"?>
<component name="org.nuxeo.ecm.core.query.test.core-types">

  <require>com.hyland.openarch.ecm.core.CoreExtensions</require>

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="schema">
    <schema name="mydublincore" prefix="mydc" src="schemas/mydublincore.xsd"/>
    <schema name="note" src="schemas/note.xsd"/>
    <schema name="testquery-lib" src="schemas/testquery-lib.xsd" />
    <schema name="testquery-schema" src="schemas/testquery-schema.xsd"  prefix="my2" />
    <schema name="testschema" src="schemas/testschema.xsd" prefix="tst" />
    <schema name="testschema3" src="schemas/testschema3.xsd" /> <!-- no prefix -->
    <schema name="age" src="schemas/age.xsd" prefix="age" />
    <!-- tags not in core -->
    <schema name="tag" src="schemas/tag.xsd" prefix="tag"/>
    <schema name="info" src="schemas/info.xsd" prefix="info" />
  </extension>

  <extension target="com.hyland.openarch.ecm.core.schema.TypeService" point="doctype">

    <!-- add mydublincore to standard doctypes -->
    <doctype name="SysFolder" extends="SysContent">
      <schema name="mydublincore"/>
      <mixin name="SysFolderish"/>
      <subtypes>
        <type>SysFolder</type>
        <type>SysOrderedFolder</type>
        <type>SysFile</type>
      </subtypes>
    </doctype>
    <doctype name="SysFile" extends="SysContent">
      <schema name="mydublincore"/>
      <schema name="sysfiles"/>
      <mixin name="SysFilish"/>
    </doctype>

    <doctype name="Note" extends="SysContent">
      <schema name="note"/>
      <schema name="testquery-schema" />
      <schema name="sysfiles"/>
      <schema name="mydublincore"/>
      <mixin name="SysVersionable"/>
    </doctype>
    <doctype name="MyDocType" extends="SysContent">
      <schema name="mydublincore"/>
      <schema name="testquery-schema" />
      <mixin name="SysFilish"/>
      <mixin name="SysVersionable"/>
    </doctype>
    <doctype name="TestDoc" extends="SysContent">
      <schema name="testschema" />
      <schema name="testschema3" />
    </doctype>
    <mixin name="Aged">
      <schema name="age" />
    </mixin>
    <!-- tags not in core -->
    <doctype name="Tag" extends="SysContent">
      <schema name="tag"/>
      <schema name="mydublincore"/>
    </doctype>
    <doctype name="Tagging" extends="SysRelation">
    </doctype>
  </extension>

</component>
