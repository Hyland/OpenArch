<?xml version="1.0"?>
<component name="com.hyland.openarch.runtime.cluster.ClusterService">

  <documentation>
    The Cluster service allows registration of the cluster node id and
    other cluster-related parameters.
  </documentation>

  <service>
    <provide interface="com.hyland.openarch.runtime.cluster.ClusterService" />
  </service>

  <implementation class="com.hyland.openarch.runtime.cluster.BasicClusterService" />

  <extension-point name="configuration">
    <documentation>
      Defines the cluster configuration:
      <code>
        <clusterNode id="123" enabled="true"/>
      </code>
    </documentation>

    <object class="com.hyland.openarch.runtime.cluster.ClusterNodeDescriptor" />
  </extension-point>

</component>
