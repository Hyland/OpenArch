<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.hyland.hxpr</groupId>
    <artifactId>hxpr-community-runtime-parent</artifactId>
    <version>12.0-SNAPSHOT</version>
  </parent>

  <artifactId>openarch-runtime-kv</artifactId>
  <name>OpenArch Runtime Key/Value Storage</name>

  <properties>
    <manifest.file>src/main/resources/META-INF/MANIFEST.MF</manifest.file>
  </properties>

  <dependencies>

    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>openarch-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>openarch-runtime</artifactId>
    </dependency>

    <dependency>
      <groupId>net.jodah</groupId>
      <artifactId>expiringmap</artifactId>
    </dependency>

    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>openarch-runtime-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- for transactional tests -->
    <dependency>
      <groupId>com.hyland.hxpr</groupId>
      <artifactId>openarch-runtime-jtajca</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <archive>
                <manifestFile>src/test/resources/META-INF/MANIFEST.MF</manifestFile>
              </archive>
            </configuration>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
