<?xml version="1.0"?>
<component name="com.hyland.openarch.runtime.metrics.MetricsService">

  <documentation>
    Filter and Report Dropwizzard Metrics and Tracing.
  </documentation>

  <service>
    <provide interface="com.hyland.openarch.runtime.metrics.MetricsService" />
  </service>

  <implementation class="com.hyland.openarch.runtime.metrics.MetricsServiceImpl" />

  <extension-point name="configuration">
    <object class="com.hyland.openarch.runtime.metrics.MetricsConfigurationDescriptor" />
  </extension-point>

  <extension-point name="reporter">
    <object class="com.hyland.openarch.runtime.metrics.MetricsReporterDescriptor" />
  </extension-point>

</component>
