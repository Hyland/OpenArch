<?xml version="1.0"?>
<component name="com.hyland.hxpr.async.tasks.test.RequiredPropertyTasks">

  <extension target="com.hyland.hxpr.async.tasks.AsyncTasksService" point="asyncTasks">
    <!-- Enabled only when its conditional property resolves to a non-blank value. -->
    <asyncTask name="gatedPresentTask" class="com.hyland.hxpr.async.tasks.DummyBatchTaskProcessor"
               conditionalOnProperty="test.async.tasks.required.present"/>
    <!-- Disabled because its conditional property is never set in the test runtime. -->
    <asyncTask name="gatedAbsentTask" class="com.hyland.hxpr.async.tasks.DummyBatchTaskProcessor"
               conditionalOnProperty="test.async.tasks.required.absent"/>
  </extension>

</component>
